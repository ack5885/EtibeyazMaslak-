{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "etibeyazmaslak",
  "main": "worker.js",
  "compatibility_date": "2026-09-02",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "ORDER_DB",
      "database_name": "etibeyaz-orders",
      "database_id": "190efa9e-dd7b-4bc8-b4eb-646c8da45e82"
    }
  ]
}
